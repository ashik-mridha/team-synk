# Copy to .env.local for development. In production set these in the Vercel project settings.
# NEXT_PUBLIC_* values are compiled into the bundle at BUILD time: after changing one, REDEPLOY.

# --- Recommended production setup: the browser talks to this site, Next.js forwards to the API ---
# REST API (relative = same origin through the rewrite)
NEXT_PUBLIC_API_URL=/api/v1
# Better Auth: leave empty to use this site's own /api/auth (forwarded by the rewrite)
NEXT_PUBLIC_AUTH_URL=
# Socket.io connects directly to the API (WebSockets cannot be proxied by Vercel rewrites)
NEXT_PUBLIC_SOCKET_URL=https://teamsync-server.onrender.com
# Server-side only: where the rewrite forwards /api/auth/* and /api/v1/*
API_PROXY_TARGET=https://teamsync-server.onrender.com

# --- Alternative: direct cross-origin calls (needs COOKIE_SAME_SITE=none on the API; some browsers block these cookies) ---
# NEXT_PUBLIC_API_URL=https://teamsync-server.onrender.com/api/v1
# NEXT_PUBLIC_AUTH_URL=https://teamsync-server.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://teamsync-server.onrender.com
# With a shared custom domain (app.example.com + api.example.com), also set the parent domain:
# NEXT_PUBLIC_COOKIE_DOMAIN=example.com

# --- Local development (API on :5000) ---
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_AUTH_URL=http://localhost:5000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
